# MandiFlow Environment Configuration Example
# Copy this file to .env and fill in your actual credentials

# LLM & Voice Transcription (Groq or Gemini)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio WhatsApp Webhook & SMS Gateway
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Admin Security Key for Mandi Secretary endpoints (/api/check-in, /api/advance-status, /api/incidents/trigger)
MANDIFLOW_ADMIN_SECRET=mandiflow_secret_2026

# Database configuration
DATABASE_URL=sqlite:///./mandiflow.db
