# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# --- Twilio (WhatsApp Sandbox) ---
# From twilio.com/console after you create a free account.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Twilio's shared sandbox number, unless you've moved to a real WhatsApp sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Groq (fast Whisper transcription + LLM intent extraction) ---
# Free key from console.groq.com — used for both the ASR call and the JSON
# intent-extraction call so the demo only depends on one external AI provider.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Mandi config ---
MANDI_ID=mandi-1
# Vehicles the yard can actually clear per hour, across all bays. This is the
# hard cap the scheduler enforces — it is what prevents the Monday pile-up.
CAPACITY_PER_HOUR=4
# Operating window, 24h clock.
DAY_START_HOUR=9
DAY_END_HOUR=17

# --- App ---
DATABASE_URL=sqlite:///./mandi.db
