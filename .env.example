# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# --- Meta WhatsApp Cloud API (free tier, NO credit card required) ---
# From developers.facebook.com after you create a free Meta Developer
# account -> create an App -> add the "WhatsApp" product. The dashboard
# gives you a temporary access token + a test phone number for free.
WHATSAPP_ACCESS_TOKEN=your_temporary_or_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_test_number_phone_number_id_here
# Make this up yourself (any string). Paste the SAME value into the
# "Verify token" field on Meta's webhook config page — it's just a shared
# secret so Meta's verification handshake trusts your endpoint.
WHATSAPP_VERIFY_TOKEN=mandi-verify-token
WHATSAPP_API_VERSION=v20.0

# --- Groq (fast Whisper transcription + LLM intent extraction) ---
# Free key from console.groq.com — used for both the ASR call and the JSON
# intent-extraction call so the demo only depends on one external AI provider.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Mandi config ---
MANDI_ID=mandi-1
# Vehicles the yard can actually clear per hour, across all bays. This is the
# hard cap the scheduler enforces — it is what prevents the Monday pile-up.
CAPACITY_PER_HOUR=4
# Operating window, 24h clock.
DAY_START_HOUR=9
DAY_END_HOUR=17

# --- App ---
DATABASE_URL=sqlite:///./mandi.db
